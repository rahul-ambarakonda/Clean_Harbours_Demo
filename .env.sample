# Application Settings
NODE_ENV="development" # Set to 'production' for production deployments
PORT="3000" # The port the Node.js server will listen on
APP_NAME="Clean Harbours Demo" # Name of the application, used for logging or display
BASE_URL="http://localhost:3000" # The base URL for the application (e.g., for API calls or redirects)

# Database Configuration
DATABASE_URL="your_database_url_here" # Connection string for the database (e.g., postgres://user:pass@host:port/dbname)
# Example PostgreSQL: postgres://user:password@localhost:5432/clean_harbours_db
# Example MongoDB: mongodb://localhost:27017/clean_harbours_db

# Security & Authentication
SESSION_SECRET="your_long_random_session_secret_here" # A secret key for session management (e.g., express-session)
JWT_SECRET="your_long_random_jwt_secret_here" # A secret key for signing JSON Web Tokens (if used for authentication)
API_KEY="your_api_key_here" # General API key for external service integrations if needed

# Email Service Configuration (e.g., for waitlist confirmations)
SMTP_HOST="your_smtp_host_here" # SMTP server host
SMTP_PORT="587" # SMTP server port (e.g., 587 for TLS, 465 for SSL)
SMTP_USER="your_smtp_username_here" # Username for SMTP authentication
SMTP_PASSWORD="your_smtp_password_here" # Password for SMTP authentication
SMTP_FROM_EMAIL="noreply@example.com" # The email address to send emails from

# Deployment & Monitoring Configuration
AWS_REGION="your_aws_region_here" # AWS region if deploying to AWS EC2
CLOUDWATCH_LOG_GROUP_NAME="clean-harbours-demo-logs" # Log group name for CloudWatch (if integrated)
SENTRY_DSN="your_sentry_dsn_here" # Sentry DSN for error tracking and monitoring (if integrated)
DOCKER_IMAGE_NAME="clean-harbours-demo" # Name of the Docker image
DOCKER_TAG="latest" # Tag for the Docker image

# NGINX Configuration (if NGINX is used as a reverse proxy)
NGINX_DOMAIN="your_domain.com" # The domain name Nginx should respond to
NGINX_PORT="80" # The public port Nginx listens on (e.g., 80 for HTTP, 443 for HTTPS)
